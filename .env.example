# Auth0
AUTH0_SECRET=                        # run: openssl rand -hex 32
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://portfolio-api

# Where the app is reachable, used to build the Auth0 callback and to send you
# back to the route you logged in from. Must match a callback URL registered on
# the Auth0 application, so changing the port here means changing it there too.
# This was missing from this file while being required by src/lib/auth0.ts, so
# `cp .env.example .env.local` produced a config that could not complete a login.
APP_BASE_URL=http://localhost:3000

# Backend API
NEXT_PUBLIC_API_URL=https://api.paulsumido.com  # http://localhost:3001 for local dev

# Site URL (used for OG image URLs — falls back to https://paulsumido.com if unset)
NEXT_PUBLIC_SITE_URL=https://paulsumido.com

# Origin serving user-uploaded media (saved gallery wall photos). Added to the
# CSP img-src, so if this is unset those photos are blocked and saved walls
# render blank. Scheme + host, no trailing slash. Must match the API's
# CDN_BASE_URL (or its bucket URL fallback).
# e.g. https://dxxxxxxxx.cloudfront.net  or  https://your-bucket.s3.your-region.amazonaws.com
NEXT_PUBLIC_MEDIA_ORIGIN=


NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Powers cross-user presence in /world. Server-side only, and deliberately NOT
# prefixed NEXT_PUBLIC_: an Ably key is appId.keyId:keySecret, so a public
# prefix would inline the secret into the browser bundle. /api/ably/token mints
# short-lived tokens scoped to the presence channel instead.
# Provision the key with publish/subscribe/presence on presence:* only, rather
# than the default of everything on channel scope *.
# Unset is fine -- presence falls back to a same-browser local transport.
ABLY_KEY=

# Shared secret sent on operator write requests so the API can tell a visitor
# using the dashboard apart from someone calling it directly with curl. Must
# match OPERATOR_SERVICE_TOKEN in portfolio_api. Server-side only: never prefix
# this with NEXT_PUBLIC_. Leave unset locally and the API skips the check.
OPERATOR_SERVICE_TOKEN=

# Optional. Powers the "Ask about this paper" box on /research.
# A ChatGPT Plus/Pro subscription does NOT include API access -- this key comes
# from platform.openai.com and is billed separately, pay-as-you-go.
# Server-side only: never prefix it with NEXT_PUBLIC_, or it ships in the bundle.
OPENAI_API_KEY=

# Optional. Overrides the default model. The ask box offers three (gpt-4o-mini,
# gpt-4.1, gpt-5) and defaults to gpt-4.1 -- critical appraisal is a reasoning
# task and the mini tier is measurably vaguer at it. Anything not on that list
# is rejected server-side rather than forwarded.
OPENAI_MODEL=

# Lets the server write the open-tier demo flags on behalf of a signed-out
# visitor. The flags API authorizes every write on a token, so without this an
# anonymous change reaches only the in-memory store and springs back on the
# next read. Same idea as OPERATOR_SERVICE_TOKEN. Server-side only: never
# prefix it with NEXT_PUBLIC_. Unset is safe -- the open tier falls back to the
# in-memory store, which is fine locally and in CI.
FLAGS_SERVICE_TOKEN=

# Required to change the admin-tier feature flags: comma-separated email addresses
# allowed to write them. Those gate live features, so being signed in is not
# the bar — the address must be listed here AND verified by the provider. Unset
# means nobody, not everybody. The open and signed-in tiers ignore this.
FLAG_ADMIN_ALLOWED_EMAILS=

# Required for the ask box: comma-separated email addresses allowed to use it.
# Unset means nobody. Kept in config rather than source because this repo is
# public and committing personal addresses publishes them to scrapers forever.
RESEARCH_ASK_ALLOWED_EMAILS=

# Authenticated end-to-end tests. Without these, globalSetup writes an empty
# storageState and every calendar spec self-skips -- a green run that proved
# nothing, which is worse than a red one. CI supplies them as secrets; locally
# they are only needed if you want that project to actually execute.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Set to "true" to drive the operator restock spec against a real backend
# instead of the seeded fallback. CI sets it for the operator-live job only.
OPERATOR_E2E_LIVE=

# Web Vitals alerting (GET /api/vitals/alert, run daily by Vercel Cron).
# CRON_SECRET is the shared secret Vercel Cron sends as `Authorization: Bearer`;
# the route rejects anything else, so an unset secret means the endpoint 401s
# every caller. Vercel injects this automatically once set in project settings.
CRON_SECRET=
# Token with `issues:write` on this repo, used to open/update/close the single
# `vitals-alert` issue when a metric goes Poor. Server-side only: never prefix
# with NEXT_PUBLIC_. Unset is safe -- the route still runs and reports the
# breaches, it just skips filing the issue (dispatched:false).
VITALS_ALERT_GITHUB_TOKEN=
# Owner/name of the repo issues are filed on. Optional: unset falls back to
# gpbsumido/paul-explore, which is what you want in production. Only set this to
# point the alerts at a different repo.
GITHUB_REPOSITORY=

# --- ESPN private fantasy leagues (Card Lab) ---
# Only needed to read a PRIVATE ESPN fantasy league (e.g. the WNBA one). The
# simplest path is to have the league commissioner make the league public, in
# which case leave these unset and it reads with no auth. Otherwise paste your
# own browser cookies from espn.com (they expire periodically). If unset, WNBA
# cards fall back to the whole night's public slate.
ESPN_S2=
ESPN_SWID=
